# Variáveis de ambiente para desenvolvimento local
# Copie este arquivo para .env.local e preencha com suas credenciais

# Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Firebase Emulators (opcional - apenas para desenvolvimento)
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_PORT=9099
NEXT_PUBLIC_FIREBASE_STORAGE_EMULATOR_PORT=9199

# App Configuration
NEXT_PUBLIC_APP_NAME=SaaS Platform
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Production Domain
NEXT_PUBLIC_PROD_URL=https://app-tsaas.alencarconsultorias.com.br

# Development Domain  
NEXT_PUBLIC_DEV_URL=https://dev-tsaas.alencarconsultorias.com.br
